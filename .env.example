# Supabase жобаңыздың параметрлерінен көшіріп алыңыз:
# Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# sentry.io -> Project Settings -> Client Keys (DSN) (міндетті емес — қателерді
# бақылау үшін; бос қалдырсаңыз, Sentry жай ғана іске қосылмайды)
EXPO_PUBLIC_SENTRY_DSN=
